# Скопируй этот файл в .env и заполни реальными значениями.
# .env НЕ коммитится в git (см. server/.gitignore).

# --- Сервер ---
PORT=4000
# Домены, которым разрешено ходить в API (через запятую). Для локальной
# разработки с index.html, открытым напрямую с диска (file://), можно
# оставить "*" — ужесточить перед реальным продакшеном.
CORS_ORIGIN=*

# --- PostgreSQL ---
# Одна строка подключения. Пример для локальной БД:
# postgres://modul3d:modul3d@localhost:5432/modul3d
DATABASE_URL=postgres://user:password@localhost:5432/modul3d

# --- JWT ---
# Длинная случайная строка (например: openssl rand -hex 32). Смена этого
# значения разлогинит всех пользователей.
JWT_SECRET=change-me-to-a-long-random-string
# Срок жизни токена сессии (формат библиотеки jsonwebtoken, напр. "7d", "12h")
JWT_EXPIRES_IN=7d

# --- Стартовый баланс токенов при регистрации ---
STARTING_TOKEN_BALANCE=20

# --- Paddle ---
# API-ключ (Paddle Dashboard -> Developer Tools -> Authentication -> API keys).
# В sandbox-аккаунте и в production-аккаунте ключи РАЗНЫЕ — не перепутай.
PADDLE_API_KEY=pdl_placeholder
# ID цены подписки, созданной в Paddle Dashboard (Catalog -> Products ->
# создать Product с рекуррентной ценой -> скопировать Price ID, вида pri_...)
PADDLE_PRICE_ID=pri_placeholder
# Секрет для проверки подписи вебхука конкретного notification destination
# (Paddle Dashboard -> Developer Tools -> Notifications -> Webhook -> Secret key)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_placeholder
# 'sandbox' (тестовые платежи, тестовые карты) или 'production' (боевые
# деньги). У sandbox и production Paddle отдельные аккаунты/ключи/вебхуки —
# не смешивать.
PADDLE_ENVIRONMENT=sandbox
# Куда Paddle checkout вернёт пользователя после оплаты (страница клиента).
# У Paddle (в отличие от Stripe) нет отдельного cancel_url — при отмене
# пользователь просто закрывает окно чекаута.
CHECKOUT_SUCCESS_URL=http://localhost:8080/?checkout=success

# --- Anthropic (Этап 2 — прокси ИИ-эскиза, POST /sketch/recognize) ---
# Ключ Anthropic API (console.anthropic.com -> Settings -> API Keys).
# Только серверный — никогда не передавай его клиенту и не коммить в git.
# Без него /sketch/recognize отвечает понятной ошибкой 503 (не роняет сервер).
ANTHROPIC_API_KEY=sk-ant-placeholder
# Стоимость одного распознавания эскиза в токенах (списывается атомарно
# с баланса token_balances перед вызовом Anthropic, см. server/README.md).
SKETCH_TOKEN_COST=1

# --- Модерация отзывов (GET /reviews/pending, POST /reviews/:id/approve|reject) ---
# Приватный токен владельца проекта — не полноценные роли пользователей,
# просто общий секрет для нескольких закрытых эндпоинтов. Передаётся
# клиентом (модерационной панелью, server/public/admin/reviews.html) в
# заголовке X-Admin-Token. Длинная случайная строка (например:
# openssl rand -hex 32). Если не задан — эти эндпоинты отвечают 503 и не
# пускают никого.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Публичный адрес сервера ---
# Используется только для формирования ссылок (например, на страницу
# модерации отзывов /admin/reviews.html в Telegram-уведомлении, см. ниже).
# Не влияет на то, где сервер реально слушает (см. PORT выше). В проде —
# домен Railway (или другого хостинга), напр. https://modul3d.up.railway.app
PUBLIC_SERVER_URL=http://localhost:4000

# --- Telegram-уведомление о новом отзыве (services/telegramNotify.js) ---
# Токен бота (получить у @BotFather в Telegram: /newbot -> следовать
# инструкциям -> скопировать токен вида 123456789:AAExxxx...). Без него
# (или без TELEGRAM_CHAT_ID ниже) уведомления просто не отправляются —
# штатное состояние, сервер не падает и POST /reviews работает как обычно.
TELEGRAM_BOT_TOKEN=
# ID чата/пользователя, куда слать уведомления. Получить: написать своему
# боту любое сообщение, затем открыть в браузере
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates и взять
# message.chat.id из ответа.
TELEGRAM_CHAT_ID=

# --- Подтверждение email при регистрации (services/emailSender.js) ---
# API-ключ транзакционной рассылки Brevo (https://app.brevo.com ->
# SMTP & API -> API Keys -> Generate a new API key). Без него письма
# подтверждения просто не отправляются (лог-warning), регистрация всё равно
# проходит, но пользователь останется с неподтверждённым email и не сможет
# оставлять отзывы/тратить токены (см. middleware/emailVerification.js).
BREVO_API_KEY=
# Отправитель письма подтверждения — формат "Имя <email>" или просто email.
# Адрес должен быть подтверждён (verified sender) в аккаунте Brevo, иначе
# Brevo отклонит отправку.
EMAIL_FROM_ADDRESS=Modul3D <noreply@modul3d.local>
EMAIL_FROM_NAME=Modul3D
# Сколько минут действительна ссылка подтверждения email после регистрации
# или запроса POST /auth/resend-verification.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60

# --- Анти-фрод при регистрации (routes/auth.js) ---
# Максимум новых аккаунтов с одного IP за 24 часа — простой барьер против
# массовой регистрации ради стартового баланса токенов (STARTING_TOKEN_BALANCE
# выше). Требует app.set('trust proxy', 1) в index.js (уже включено) —
# сервер должен быть за доверенным прокси хостинга, иначе IP всегда будет
# адресом самого прокси.
REGISTRATION_IP_DAILY_LIMIT=3
